2023-10-31 10:31:34 [http-nio-8080-exec-1] DEBUG org.hibernate.SQL - 
    SELECT
        DISTINCT account1 as account,
        account2 as name,
        u.id 
    FROM
        (     SELECT
            CASE             
                WHEN t.account_id = ? THEN t.oppo_account_id             
                ELSE t.account_id         
            END AS account1,
            CASE             
                WHEN t.account_id = ? THEN t.oppo_account_name             
                ELSE t.account_name         
            END AS account2     
        FROM
            transaction t     
        WHERE
            t.account_id = ? 
            OR t.oppo_account_id = 46012000014325     
            AND (
                (
                    CASE                 
                        WHEN t.account_id = ? THEN t.oppo_account_name                 
                        ELSE t.account_name             
                    END IS NOT NULL             
                    AND CASE                 
                        WHEN t.account_id = ? THEN t.oppo_account_name                 
                        ELSE t.account_name             
                    END != 'string'         
                )         
                OR (
                    CASE                 
                        WHEN t.account_id = ? THEN t.oppo_account_id                 
                        ELSE t.account_id             
                    END IS NOT NULL         
                )     
            ) ) AS interactions 
    INNER JOIN
        wallet w 
            ON w.account_id = interactions.account1 
    INNER JOIN
        user_wallet uw 
            ON uw.wallet_id = w.id 
    INNER JOIN
        `user` u 
            ON uw.user_id = u.id 
    WHERE
        (
            account1 IS NOT NULL 
            OR account2 IS NOT NULL
        ) 
        AND (
            account1 IS NOT NULL 
            AND account2 IS NOT NULL
        ) 
        AND (
            account1 != 'string' 
            AND account2 != 'string'
        )
