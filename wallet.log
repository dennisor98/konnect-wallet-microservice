2023-10-31 00:10:15 [http-nio-8080-exec-1] DEBUG org.hibernate.SQL - 
    SELECT
        DISTINCT CASE    
            WHEN t.account_id = ? THEN t.oppo_account_id    
            ELSE t.account_id 
        END AS account,
        CASE    
            WHEN t.account_id = ? THEN t.oppo_account_name    
            ELSE t.account_name 
        END AS name 
    FROM
        transaction t 
    WHERE
        (
            t.account_id = ? 
            OR t.oppo_account_id = ?
        ) 
        AND (
            (
                (
                    t.account_id = ? 
                    AND t.oppo_account_name IS NOT NULL 
                    AND t.oppo_account_name != 'string'
                )    
                OR    (
                    t.oppo_account_id = ? 
                    AND t.account_name IS NOT NULL 
                    AND t.account_name != 'string'
                )
            )
        )
