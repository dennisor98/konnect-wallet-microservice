2023-10-31 00:47:33 [http-nio-8080-exec-1] DEBUG org.hibernate.SQL - 
    SELECT
        DISTINCT CASE     
            WHEN t.account_id = ? THEN t.oppo_account_id     
            ELSE t.account_id 
        END AS account1,
        CASE     
            WHEN t.account_id = ? THEN t.oppo_account_name     
            ELSE t.account_name 
        END AS account2,
        u.id 
    FROM
        transaction t 
    INNER JOIN
        wallet w 
            ON     CASE         
                WHEN t.account_id = ? THEN t.oppo_account_id         
                ELSE t.account_id     
            END = w.account_id 
    INNER JOIN
        user_wallet uw 
            ON uw.wallet_id = w.id 
    INNER JOIN
        user u 
            ON uw.user_id = u.id 
    WHERE
        (
            CASE         
                WHEN t.account_id = ? THEN t.oppo_account_name         
                ELSE t.account_name     
            END IS NOT NULL     
            AND     CASE         
                WHEN t.account_id = ? THEN t.oppo_account_name         
                ELSE t.account_name     
            END != 'string'
        )     
        OR     (
            CASE         
                WHEN t.account_id = ? THEN t.oppo_account_id         
                ELSE t.account_id     
            END IS NOT NULL
        )     
        AND     (
            (
                t.account_id IS NOT NULL 
                OR t.account_name IS NOT NULL
            )         
            AND         (
                t.account_id != 'string' 
                AND t.account_name != 'string'
            )     
        )
